{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "sp-client",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--dir",
        "sp-client",
        "dev"
      ],
      "port": 8080
    },
    {
      "name": "survivors",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--dir",
        "survivors",
